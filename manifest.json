{
  "manifest_version": 3,
  "name": "Custom Subtitles for YouTube",
  "version": "1.1",
  "description": "Load your own translated SRT/VTT subtitle file on YouTube videos.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "custom-subtitles-for-youtube@example.org",
      "strict_min_version": "109.0"
    }
  }
}
